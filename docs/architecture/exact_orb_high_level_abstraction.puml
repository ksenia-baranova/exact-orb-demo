@startuml
title exact-orb — высокоуровневая архитектура и граница реализации
scale max 2800 width

left to right direction

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam DefaultFontSize 13
skinparam ArrowFontSize 11
skinparam nodesep 44
skinparam ranksep 52

skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #1E293B
}
skinparam component {
  BorderColor #64748B
  FontColor #0F172A
}
skinparam database {
  BorderColor #15803D
  FontColor #0F172A
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #D97706
  FontColor #451A03
}

actor "Пользователь" as User


component "<b>Standalone CLI</b>\n<color:#166534>[реализован]</color>\nПрямой deterministic flow:\nnatal / cosmogram / transit" as CLI #DCFCE7


component "<b>Клиент и HTTP API</b>\n<color:#475569>[не реализованы]</color>\nФорма данных рождения, chart renderer\nTransport DTO, session cookie, JSON / SSE" as Edge #E5E7EB


component "<b>Application coordination</b>\n<color:#9A3412>[следующий этап]</color>\nApplicationOrchestrator: session lifecycle,\nhandler routing, freshness и state commit\n\nBuildNatalHandler: <color:#166534>реализован</color>" as App #FFEDD5


component "<b>Детерминированный контур</b>\n<color:#166534>[реализован]</color>\nBirthDataResolver\nChartArtifactResolver + CalculationCache(bytes)\nCalculationEnginePort → in-process EngineService\n\nПервый application-срез: natal / cosmogram" as Deterministic #DCFCE7


database "<b>Session state</b>\n<color:#166534>[реализован]</color>\nSessionState + отдельный DialogStore\nstate_version, birth_input, birth_resolved,\nодна base ChartSpec, TTL и CAS" as SessionState #DCFCE7


component "<b>Agent Runtime</b>\n<color:#92400E>[каркас]</color>\nPlanner + immutable scenarios\nPolicy boundary + ordered Tool execution\nНе управляет application lifecycle" as AgentRuntime #FEF3C7


component "<b>Interpretation Service</b>\n<color:#92400E>[контракты и каркас]</color>\nEvidence → один PromptBundle\nInterpretation cache + budget\nLLM Gateway (<color:#166534>transport реализован</color>)\nOutput Guard" as Interpretation #FEF3C7


cloud "<b>LLM Provider</b>\nТолько формулирует ответ" as LLM #F1F5F9


component "<b>Сквозные контроли</b>\n<color:#92400E>[частично / план]</color>\nCapabilities, policy и admission\nStructured logging; metrics / tracing later" as Controls #FEF3C7


component "<b>Research Corpus</b>\n<color:#92400E>[частично реализован]</color>\nWhitelist ChartArtifact → ChartFeatures\nAppend-only port + in-memory adapter\nProducer wiring и persistence — later" as Research #FEF3C7


package "POST-MVP: FREE-FORM" as Future #F8FAFC {
  component "<b>Request understanding</b>\nInputGuard → IntentService\n→ ContractValidator / query policy" as NL #E5E7EB
}


' Реализованный standalone-путь
User -[#2563EB]-> CLI
CLI -[#2563EB]-> Deterministic : direct calculation\n→ typed chart result


' Следующий application-срез
User -[#7E57C2,dashed]-> Edge
Edge -[#D97706,dashed]-> App : typed command + session_id\n→ JSON response

App -[#D97706,dashed]down-> SessionState : load / CAS commit StateDelta\n→ typed state outcome

App -[#D97706,dashed]down-> Deterministic : BirthInput + NatalChartSpec\n→ ChartArtifact; handler forms StateDelta

' Целевой preset interpretation-flow
App -[#7E57C2,dashed]-> AgentRuntime : interpretation handler\n+ ResolvedContract\n→ typed outcome
AgentRuntime -[#7E57C2,dashed]down-> Deterministic : approved ToolRequests\n→ ToolResults

AgentRuntime -[#7E57C2,dashed]-> Interpretation : plan + ToolResults\n→ safe response
Interpretation -[#EF6C00]-> LLM : one PromptBundle\n→ token stream


' Отложенный free-form input edge
Edge -[#7E57C2,dashed]down-> NL : free-form question [future]
NL -[#7E57C2,dashed]-> AgentRuntime : ResolvedContract only\nvia InterpretMessageHandler
NL -[#7E57C2,dashed]-> Interpretation : AuthorizedInterpretationQuery


' Исследовательский write path не подключён к application lifecycle
Deterministic -[#7E57C2,dashed]down-> Research : future producer wiring\nfrom ChartArtifact


' Сквозные контроли
Controls -[#64748B,dashed]-> Edge
Controls -[#64748B,dashed]-> App
Controls -[#64748B,dashed]-> AgentRuntime
Controls -[#64748B,dashed]-> Interpretation


note bottom of Deterministic
<b>Вероятностное — только по краям.</b>

Resolution, calculation key,
расчёт карты, planning,
tool execution и отбор Evidence
детерминированы.

Engine находится за typed port,
но сейчас исполняется в том же
модульном монолите, без сети.
end note


note bottom of App
BuildNatalHandler рассчитывает карту
и формирует StateDelta,
но не применяет её.

ApplicationOrchestrator возвращает
окончательный success только после
подтверждённого state commit.
end note


note bottom of SessionState
В первом MVP нет derived_chart,
active_view и SetActiveView.

Они возвращаются одним изменением
границы только вместе с транзитами
в application-срезе.
end note


note bottom of AgentRuntime
Agent Runtime вызывается только
из interpretation handlers.

BuildNatalHandler обращается
к ChartArtifactResolver напрямую
и Agent Runtime не использует.
end note


note bottom of Interpretation
LLM не рассчитывает карту,
не выбирает tools
и не изменяет SessionState.

Один сценарий =
один PromptBundle =
один вызов LLM.
end note


note bottom of NL
Raw text не входит в ResolvedContract
и не влияет на planning, tools
или параметры расчёта.

После policy он передаётся только
в interpretation pipeline как
AuthorizedInterpretationQuery.
end note


legend bottom
<b>СТАТУС КОМПОНЕНТА</b>
|<#DCFCE7>| Реализован |
|<#FEF3C7>| Частично реализован / каркас |
|<#FFEDD5>| Ближайший этап wiring |
|<#E5E7EB>| Запланирован / post-MVP |
|<#F1F5F9>| Внешняя система |

<b>ТИП СВЯЗИ</b>
|<color:#2563EB><b>━━━━▶</b></color>| Реализованный request / result flow |
|<color:#D97706><b>┄┄┄┄▶</b></color>| Ближайший application wiring |
|<color:#7E57C2><b>┄┄┄┄▶</b></color>| Целевой / post-MVP flow |
|<color:#EF6C00><b>━━━━▶</b></color>| Вызов внешнего provider |
|<color:#64748B><b>┄┄┄┄▶</b></color>| Cross-cutting control |
endlegend

@enduml
