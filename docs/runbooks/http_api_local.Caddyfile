https://exact-orb.localhost {
    bind 127.0.0.1
    tls {$EXACT_ORB_LOCAL_CERT} {$EXACT_ORB_LOCAL_KEY}

    handle /health/* {
        respond 404
    }

    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
}
