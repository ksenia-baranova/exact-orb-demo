{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "compact": {
      "format": "%(asctime)s %(levelname)s logger=%(name)s %(message)s"
    }
  },
  "handlers": {
    "diagnostic_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "compact",
      "filename": "logs/http-api/local.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "encoding": "utf-8"
    },
    "stderr": {
      "class": "logging.StreamHandler",
      "level": "WARNING",
      "formatter": "compact",
      "stream": "ext://sys.stderr"
    },
    "server_stderr": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "compact",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "exact_orb": {
      "level": "INFO",
      "handlers": ["diagnostic_file", "stderr"],
      "propagate": false
    },
    "uvicorn": {
      "level": "INFO",
      "handlers": ["server_stderr"],
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": ["server_stderr"],
      "propagate": false
    }
  }
}
