@startuml
title exact-orb — N4: ошибка Calculation Engine

autonumber
hide footbox

skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequence {
    ArrowColor #2563EB
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #FFFFFF
    ParticipantBorderColor #64748B
    ParticipantFontColor #0F172A
    ParticipantBackgroundColor #F8FAFC
    ActorBorderColor #64748B
    ActorFontColor #0F172A
    ActorBackgroundColor #DBEAFE
    GroupBorderColor #94A3B8
    GroupHeaderFontColor #1E293B
    DividerBorderColor #94A3B8
    DividerFontColor #1E293B
    NoteBorderColor #94A3B8
    NoteBackgroundColor #FFFBEA
    NoteFontColor #334155
}

actor "Пользователь" as User

box "CLIENT / API" #DBEAFE
    boundary "Frontend" as FE
    boundary "FastAPI" as API
end box

box "APPLICATION" #FFEDD5
    control "Orchestrator" as Orch
    control "BuildNatalHandler" as Handler
end box

box "SESSION STATE" #D1FAE5
    control "ContextService" as Context
    database "Session Store" as Store
end box

box "RESOLUTION" #D9F9FF
    control "BirthDataResolver" as Resolver
end box

box "ARTIFACTS / ENGINE" #FFF7CC
    control "ChartArtifactResolver" as Artifact
    database "Calculation Cache" as Cache
    control "CalculationEnginePort" as Engine
end box

User -> FE : Отправляет валидные данные
FE -> API : POST /charts/natal
API -> Orch : BuildNatalCommand

Orch -> Context : start_build(...)
Context -> Store : save BuildAttempt(PROCESSING)
Store --> Context : saved
Context --> Orch : build registered

Orch -> Handler : handle(command, SessionContext)
Handler -> Resolver : resolve(BirthInput)
Resolver --> Handler : ResolvedBirthData

Handler -> Artifact : ensure_natal(ResolvedBirthData, ChartSpec)
Artifact -> Cache : get(calculation_key)
Cache --> Artifact : miss
Artifact -> Engine : calculate_natal(request)

Engine -[#C62828]-> Artifact : CalculationFailed\n(error_code, retryable)
Artifact --> Handler : CalculationFailed
Handler --> Orch : CalculationFailed

Orch -> Context : mark_build_failed(run_id, error_code)
Context -> Store : PROCESSING → FAILED
Store --> Context : saved
Context --> Orch : confirmed

Orch --> API : 500 / 503 CalculationFailed
API --> FE : typed retryable error
FE --> User : Показывает ошибку и кнопку «Повторить»

note over Artifact, Cache
Failure и partial artifact
не записываются в Calculation Cache.
end note

note over Handler, Store
ProfileService не вызывается.
Ранее успешный SessionProfile
остаётся неизменным.
end note

@enduml
