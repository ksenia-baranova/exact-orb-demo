@startuml
title exact-orb — BuildNatal: lifecycle-события ApplicationOrchestrator

' Реализованный observability contract ApplicationOrchestrator R3.2.
' Orchestrator хранит operation state только в локальных переменных execute().

autonumber
hide footbox

skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequence {
    ArrowColor #2563EB
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #FFFFFF
    ParticipantBorderColor #64748B
    ParticipantFontColor #0F172A
    ParticipantBackgroundColor #F8FAFC
    NoteBorderColor #94A3B8
    NoteBackgroundColor #FFFBEA
    NoteFontColor #334155
}

box "INPUT BOUNDARY" #DBEAFE
    boundary "Request task" as Request
end box

box "APPLICATION" #FFEDD5
    control "ApplicationOrchestrator" as Orch
    control "BuildNatalHandler" as Handler
    collections "Structured Log" as Log
end box

box "SESSION" #D1FAE5
    control "ContextService" as Context
end box

box "BUILD NATAL DEPENDENCIES" #E8F5E9
    control "BirthDataResolver" as Resolver
    control "ChartArtifactResolver" as Artifacts
end box

Request -> Orch : execute(command, session_id, run)
activate Orch
note right of Orch
RunContext frozen; Handler получает тот же объект.
run_id, started_at и deadline не переприсваиваются.
end note
Orch -> Log : INFO application_operation_started\nrun_id, command_type
Orch -> Log : DEBUG component_message direction=in\noperation=application_execute; command, session_id, run

Orch -> Orch : exact routing by type(command)
Orch -> Log : INFO application_message direction=send\npeer=ContextService, message_type=ContextLoadRequest
Orch -> Context : load(session_id)
Context -> Log : DEBUG component_message direction=in\noperation=context_load, run_id=-
Context -> Log : DEBUG component_message direction=out\nmessage_type=SessionSnapshot, run_id=-
Context --> Orch : SessionSnapshot(state_version=N)
Orch -> Log : INFO application_message direction=receive\npeer=ContextService, message_type=SessionSnapshot
Orch -> Log : DEBUG application_stage_finished\nstage=load, outcome=loaded, duration_ms

Orch -> Log : INFO application_message direction=send\npeer=BuildNatalHandler, message_type=BuildNatalRequest
Orch -> Handler : handle(command, snapshot.state, same run)
Handler -> Log : INFO application_message direction=send\npeer=BirthDataResolver, message_type=BirthResolutionRequest
Handler -> Resolver : resolve(birth_input, run)
Resolver --> Handler : ResolvedBirthData
Handler -> Log : INFO application_message direction=receive\nmessage_type=ResolvedBirthData
Handler -> Log : INFO application_message direction=send\npeer=ChartArtifactResolver, message_type=EnsureChartRequest
Handler -> Artifacts : ensure_chart(spec, resolved, run)
Artifacts --> Handler : ChartArtifact
Handler -> Log : INFO application_message direction=receive\nmessage_type=ChartArtifact
Handler --> Orch : BuildNatalSuccess(artifact, delta)
Orch -> Log : INFO application_message direction=receive\npeer=BuildNatalHandler, message_type=BuildNatalSuccess
Orch -> Log : DEBUG application_stage_finished\nstage=handler, outcome=success, duration_ms

Orch -> Log : INFO application_message direction=send\npeer=ContextService, message_type=ContextSaveRequest, attempt=1
Orch -> Context : save(session_id, N, delta)
Context -> Log : DEBUG component_message direction=in\noperation=context_save, run_id=-
Context -> Log : DEBUG component_message direction=out\nmessage_type=StateCommitFailed, run_id=-
Context --> Orch : StateCommitFailed(error_code_1)
Orch -> Log : INFO application_message direction=receive\npeer=ContextService, message_type=StateCommitFailed, attempt=1
Orch -> Log : WARNING application_commit_attempt_finished\nattempt=1, outcome=state_commit_failed, detail_code

alt retry разрешён
    Orch -> Log : INFO application_message direction=send\npeer=ContextService, message_type=ContextSaveRequest, attempt=2
    Orch -> Context : save(session_id, N, same delta)
    Context -> Log : DEBUG component_message direction=in\noperation=context_save, run_id=-
    Context -> Log : DEBUG component_message direction=out\nmessage_type=Committed, run_id=-
    Context --> Orch : Committed(state_version=N+1)
    Orch -> Log : INFO application_message direction=receive\npeer=ContextService, message_type=Committed, attempt=2
    Orch -> Log : WARNING application_commit_attempt_finished\nattempt=2, outcome=committed
    Orch -> Orch : ApplicationCommitted
else retry запрещён отменой или deadline
    Orch -> Orch : ApplicationStateCommitFailure
end

Orch -> Log : log_operation_finished(result=ApplicationResult, ...)\nINFO/WARNING application_operation_finished\nterminal_kind=result, statuses, code, state_version,\nstage durations, commit_attempts
Orch --> Request : ApplicationResult
deactivate Orch

note over Orch, Log
На каждый execute приходится ровно один started
и ровно один terminal event. Stage event появляется
только после завершения стадии; commit-attempt event —
только для фактически начатого save.

На входе Orchestrator payload команды и полный
session_id пишутся отдельным DEBUG-сообщением.
StateDelta, ChartArtifact и полный session_id
в lifecycle events не записываются.
Lifecycle event: имя + один JSON object.
INFO application_message показывает только прямые
вызовы Orchestrator и Handler; тела отсутствуют.
На cache miss отдельный calculation_message
показывает вызовы Artifacts -> Engine ->
NatalTechniqueAdapter -> calculate_natal;
подробности в chart_artifacts/001.
ContextService пишет полные DEBUG in/out,
но не получает RunContext, поэтому run_id=-.
Поля terminal берутся из возвращаемого результата.
Невалидные длительности/попытки отклоняются до записи.
Ошибка logging не меняет подтверждённый commit outcome.
end note

note over Request, Log
При отмене до commit ApplicationResult отсутствует,
но terminal_kind=cancelled записывается до CancelledError.
При отмене после старта commit см. диаграмму 009.
end note

note over Orch
Длительности, commit attempts, error codes и признак
отменённой доставки живут только в frame execute().
Registry активных run_id и общих counters нет.
end note

@enduml
