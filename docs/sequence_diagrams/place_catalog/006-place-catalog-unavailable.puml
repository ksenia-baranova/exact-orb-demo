@startuml
title exact-orb — BirthDataResolver: SQLite-каталог технически недоступен

autonumber
hide footbox

skinparam shadowing false
skinparam responseMessageBelowArrow true

skinparam sequence {
    ArrowColor #2563EB
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #FFFFFF

    ParticipantBorderColor #64748B
    ParticipantFontColor #0F172A
    ParticipantBackgroundColor #F8FAFC

    GroupBorderColor #94A3B8
    GroupHeaderFontColor #1E293B

    DividerBorderColor #94A3B8
    DividerFontColor #1E293B

    NoteBorderColor #94A3B8
    NoteBackgroundColor #FFFBEA
    NoteFontColor #334155
}

box "TARGET TRANSPORT — M1-6" #DBEAFE
    boundary "Build API" as API
end box

box "IMPLEMENTED APPLICATION" #FFEDD5
    control "ApplicationOrchestrator" as Orch
    control "ContextService" as Context
    control "BuildNatalHandler" as Handler
end box

box "IMPLEMENTED RESOLVER + TARGET CATALOG — M1-5" #D9F9FF
    control "BirthDataResolver" as Resolver
    control "SqlitePlaceCatalog\nкак PlaceCatalog" as Catalog
    database "places.sqlite" as DB
end box


API -> Orch : execute(BuildNatalCommand(\n BirthInput(..., place_id = "524901")\n), session_id, run)
activate Orch

Orch -> Orch : route по точному типу команды
Orch -> Context : load(session_id)
Context --> Orch : SessionSnapshot(state)
Orch -> Handler : handle(command, state, run)
activate Handler
Handler -> Resolver : resolve(birth_input, run=run)
activate Resolver

Resolver -> Catalog : lookup("524901")
activate Catalog
Catalog -> DB : SELECT place WHERE place_id = "524901"
activate DB
DB -[#C62828]-> Catalog : runtime read failure
deactivate DB
Catalog -[#C62828]-> Resolver : raises PlaceCatalogUnavailableError
deactivate Catalog

Resolver --> Handler : ResolutionUnavailable(\n error_code = "PLACE_CATALOG_UNAVAILABLE",\n retryable = true\n)
deactivate Resolver
Handler --> Orch : ResolutionUnavailable
deactivate Handler

Orch --> API : ApplicationResolutionFailure(\n code = "RESOLUTION_UNAVAILABLE",\n retryable = true\n)
deactivate Orch

note over Resolver, Catalog
Технический отказ зависимости не становится
InputRequired: исправление пользовательского
ввода не восстановит недоступный каталог.

Каталог успешно прошёл open/startup validation;
ошибка возникла при чтении во время запроса.
end note

note over Handler, Orch
Расчёт и commit не выполняются.
end note

@enduml
